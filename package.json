{
  "name": "halden",
  "version": "1.0.0",
  "private": true,
  "description": "Website for The Halden, a pre-construction condo tower on Biscayne Bay in Miami.",
  "author": "SashaShp",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests *.config.*",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests *.config.* *.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.182.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
